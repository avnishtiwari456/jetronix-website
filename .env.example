# Copy this file to .env and fill in the values. Never commit the real .env.

# ─── Email notifications ────────────────────────────────────────────────────
# Where contact and quote submissions are emailed. Every enquiry is also
# appended to data/inquiries.jsonl regardless of these settings.
MAIL_TO="support@jetronixindia.com"

# SMTP account used to SEND the mail. Get these from your email provider
# (Google Workspace, Zoho, Hostinger, GoDaddy, your cPanel host, etc).
# If any of HOST/USER/PASS is missing, the site still works and still records
# enquiries to disk — it just will not send email.
SMTP_HOST=""              # e.g. smtp.zoho.in  |  smtp.gmail.com  |  smtp.hostinger.com
SMTP_PORT="587"           # 587 for STARTTLS (usual), 465 for SSL
SMTP_SECURE=""            # leave blank to auto-pick, or "true" for port 465
SMTP_USER=""              # the full mailbox address, e.g. support@jetronixindia.com
SMTP_PASS=""              # mailbox password, or an app-specific password

# Optional. Defaults to "Jetronix Website <SMTP_USER>".
# Most providers reject a From address that is not the authenticated mailbox.
MAIL_FROM=""

# ─── AI Advisor ─────────────────────────────────────────────────────────────
# Optional. Without it the site works fully except the AI Advisor page,
# which returns a 503. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ─── Hosting ────────────────────────────────────────────────────────────────
# The port to listen on. Hosting platforms usually inject this themselves.
PORT="3000"
